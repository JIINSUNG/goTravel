# 복사해서 .env.local로 저장하고 본인 값을 채우세요. .env.local은 커밋되지 않습니다(.gitignore의 *.local).

# 동기화(Firebase) 전용 — 비워두면 동기화 기능 자체가 꺼진 채로 앱이 동작해요(설정 화면에 섹션이 안 보임).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 지도(카카오맵) 전용 — 비워두면 지도/장소 검색 없이 주소를 직접 입력하는 걸로 대신해요.
# 카카오 디벨로퍼스(developers.kakao.com) > 내 애플리케이션 > 앱 키의 "JavaScript 키".
# 플랫폼 설정에 이 앱을 띄울 도메인(localhost:5173, 배포 주소)을 웹 플랫폼으로 등록해야 해요.
VITE_KAKAO_APP_KEY=
